{
  "compilerOptions": {
    // target
    "target": "es2024",
    "moduleDetection": "force",
    // options
    "sourceMap": false,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "removeComments": true,
    // strict
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedSideEffectImports": true,
  }
}